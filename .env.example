## Site
# Production site URL (used for sitemap, canonical links, and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://shirwell-bancan.vercel.app
#
# Customer support phone for Google Publisher Center / RRM (E.164), e.g. +61412345678
# NEXT_PUBLIC_SUPPORT_PHONE=+61412345678
#
# Optional: comma-separated social/profile URLs for Google JSON-LD (Spotify, YouTube, etc.)
# NEXT_PUBLIC_SAME_AS=https://open.spotify.com/artist/...,https://www.youtube.com/@...
#
## Google
# HTML meta tag `content` from Search Console → Verification → HTML tag
GOOGLE_SITE_VERIFICATION=your-google-site-verification-token
#
# Google Analytics 4 (gtag.js) — measurement ID from GA / Tag Assistant
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
#
# Google Tag Manager
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
#
# Google Ads conversion tag (gtag.js)
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_PAGE_VIEW_SEND_TO=AW-XXXXXXXXX/YYYYYYYYYY
#
## AI support chat (optional — uses OpenAI when set; otherwise built-in guide)
# OPENAI_API_KEY=sk-...
# OPENAI_SUPPORT_MODEL=gpt-4o-mini
#
## Google AdSense (web)
# Publisher ID must include the "ca-" prefix: ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADSENSE_SLOT_ENTERPRISES=1200415498
# NEXT_PUBLIC_ADSENSE_SLOT_BOX=1844130903
# NEXT_PUBLIC_ADSENSE_SLOT_BANNER=1234567890
# NEXT_PUBLIC_ADSENSE_TEST=true   # Google test ads — verify slots before site approval
#
# Revenue tips (AdSense console, not env):
# - Sites → add shirwell-bancan.vercel.app → wait for Ready
# - Ads → Auto ads → enable Anchor, Side rail, Vignette (extra revenue on top of manual units)
# - Complete Payments profile or live ads stay empty
#
## Subscribe with Google (Publisher Center — CMS sync)
# Open-access product id from Publisher Center → CMS Sync → Open access snippet
# NEXT_PUBLIC_SWG_OPEN_ACCESS_PRODUCT_ID=CAow5KfHDA:openaccess
#
# Premium paywall product id — Publisher Center → Content access → Paywall → Live plan
# Product ID slug (e.g. "premium") becomes CAow5KfHDA:premium when publication prefix is CAow5KfHDA
# NEXT_PUBLIC_SWG_PREMIUM_PRODUCT_ID=CAow5KfHDA:premium
#
# SwG is disabled on localhost by default (CORS / Publisher Center domain approval).
# Set NEXT_PUBLIC_SWG_ENABLED=true only if testing SwG against an approved domain.
# NEXT_PUBLIC_SWG_ENABLED=true

## Supabase (Auth + content)
# Copy URL and keys from Supabase → Project Settings → API (or Connect).
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
#
# Use either legacy anon JWT or new publishable key (this app accepts both):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#
# Server-only — set in Vercel/hosting dashboard only. NEVER commit or use NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
#
# OAuth redirect (configure in Supabase Auth → URL Configuration):
# https://your-domain.com/auth/callback
# Enable Google + Apple under Auth → Providers (Apple: Services ID + key from Apple Developer).
#
# OAuth Server (beta): set Authorization path to /oauth/consent (this repo implements it).
# Set Site URL in Auth → URL Configuration to your origin without a trailing slash so
# Supabase does not build //oauth/consent.

## Apple In-App Purchase (iOS app — StoreKit)
# Create subscription products in App Store Connect; IDs must match below.
# APPLE_IAP_PRODUCT_PREMIUM_MONTHLY=com.shirwell.premium.monthly
# APPLE_IAP_PRODUCT_PREMIUM_YEARLY=com.shirwell.premium.yearly
# NEXT_PUBLIC_APPLE_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXX
#
# App Store Server API (verify purchases + webhooks) — from App Store Connect → Users and Access → Keys:
# APPLE_APP_STORE_ISSUER_ID=
# APPLE_APP_STORE_KEY_ID=
# APPLE_APP_STORE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
#
# Enable only after JWS verification is implemented in /api/apple/iap/sync and /webhook:
# APPLE_IAP_JWS_VERIFICATION_ENABLED=true
#
# Webhook URL (App Store Connect): https://your-domain.com/api/apple/iap/webhook
# iOS app sync after purchase: POST https://your-domain.com/api/apple/iap/sync
#
## Stripe (Premium card subscriptions on web)
# Dashboard → Products → recurring prices (monthly + yearly)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PREMIUM_MONTHLY=price_...
# STRIPE_PRICE_PREMIUM_YEARLY=price_...
#
# Webhook URL (Stripe Dashboard → Developers → Webhooks):
#   https://your-domain.com/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
#
# Enable Stripe Customer Portal (Settings → Billing → Customer portal) for manage/cancel.

## Google AdMob (native iOS/Android app — NOT the website)
# Website uses AdSense above. AdMob runs only in the mobile app SDK.
# Developer website for app-ads.txt: https://shirwell-bancan.vercel.app
#
# ADMOB_APP_ID=ca-app-pub-2495432679632375~1624956947
# ADMOB_BANNER_AD_UNIT_ID=ca-app-pub-2495432679632375/2861130889
# ADMOB_APP_OPEN_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
#
# iOS Info.plist: GADApplicationIdentifier = ADMOB_APP_ID
# Android AndroidManifest.xml meta-data: com.google.android.gms.ads.APPLICATION_ID
