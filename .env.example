## Site
# NEXT_PUBLIC_SITE_URL=https://shirwell.com
#
## Google
# HTML meta tag content from Search Console (optional)
# GOOGLE_SITE_VERIFICATION=
#
# Google Analytics 4 (gtag.js) — measurement ID from GA / Tag Assistant
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
#
# Google Tag Manager
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
#
## Google AdSense (web)
# From AdSense Account information / Sites:
# Publisher ID in UI looks like: pub-2495432679632375
# This env var must include the "ca-" prefix: ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
#
# Optional: Display ad unit slot id (a number) if you are placing <AdSenseUnit /> blocks.
# Create it in AdSense → Ads → By ad unit → Display.
# NEXT_PUBLIC_ADSENSE_SLOT_BANNER=1234567890

## Supabase (Auth + content)
# Copy URL and keys from Supabase → Project Settings → API (or Connect).
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
#
# Use either legacy anon JWT or new publishable key (this app accepts both):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#
# NEVER commit the service_role / secret key. Never use NEXT_PUBLIC_ for it.
# If you need it for server-only scripts, set e.g. SUPABASE_SERVICE_ROLE_KEY in your
# hosting dashboard only — not in this repo.
#
# OAuth redirect (configure in Supabase Auth → URL Configuration):
# https://your-domain.com/auth/callback
# Enable Google + Apple under Auth → Providers (Apple: Services ID + key from Apple Developer).
#
# OAuth Server (beta): set Authorization path to /oauth/consent (this repo implements it).
# Set Site URL in Auth → URL Configuration to your origin without a trailing slash so
# Supabase does not build //oauth/consent.

## Google AdMob (native Android/iOS app wrapper — not used by Next.js web pages)
# App ID (from AdMob app settings):
# ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
# App Open ad unit id:
# ADMOB_APP_OPEN_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/nnnnnnnnnn
# Another AdMob ad unit id:
# ADMOB_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/nnnnnnnnnn
