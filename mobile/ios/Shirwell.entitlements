<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Shirwell.entitlements — enable Associated Domains in Xcode
  Requires APPLE_TEAM_ID + live apple-app-site-association on your domain
-->
<plist version="1.0">
<dict>
  <key>com.apple.developer.associated-domains</key>
  <array>
    <string>applinks:shirwell-bancan.vercel.app</string>
  </array>
</dict>
</plist>
